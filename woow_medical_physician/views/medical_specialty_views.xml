<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Specialty List View                                          -->
    <!-- ============================================================ -->
    <record id="medical_specialty_view_list" model="ir.ui.view">
        <field name="name">medical.specialty.list</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <list string="Specialties" editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Specialty Action                                             -->
    <!-- ============================================================ -->
    <record id="medical_specialty_action" model="ir.actions.act_window">
        <field name="name">Specialties</field>
        <field name="res_model">medical.specialty</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first specialty
            </p>
        </field>
    </record>

</odoo>
